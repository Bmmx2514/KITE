HOST=127.0.0.1
PORT=9621
WORKING_DIR=./.lightrag/baseline
INPUT_DIR=./.lightrag/inputs-baseline
LOG_DIR=./.lightrag/logs
LLM_BINDING=openai
LLM_MODEL=deepseek-flash
LLM_BINDING_HOST=https://api.deepseek.com
LLM_BINDING_API_KEY=<DeepSeek API Key>
MAX_ASYNC_LLM=2
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_BINDING_API_KEY=<Bailian API Key>
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIM=1024
EMBEDDING_USE_BASE64=false
RERANK_BINDING=aliyun
RERANK_MODEL=qwen3.7-text-rerank
RERANK_BINDING_HOST=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_BINDING_API_KEY=<Bailian API Key>
RERANK_BY_DEFAULT=true
KITE_WORKBENCH_TOKEN=<Random local token of at least 24 characters>
KITE_WORKBENCH_OPERATOR=local-admin
